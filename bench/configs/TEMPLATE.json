{
  "protocol": "aiml-bench/2.0",
  "_readme": "Don't fill this by hand: `python3 bench/harness/catalog.py plan <family> --write` writes bench/configs/<study_id>.json from the catalog and this template. Fields under request, prompts, sweep, thresholds and quality are fixed by the protocol (bench/benchmark-protocol.md); run_bench.py refuses a config that changes them.",
  "study": {
    "id": "FILL_ME <family>_<quant>_<machine>_<YYYYMMDD>",
    "member": "FILL_ME name or netid",
    "machine": "FILL_ME hostname",
    "hardware": "FILL_ME",
    "family": "FILL_ME",
    "notes": ""
  },
  "quantization": "FILL_ME the study's build format from the catalog, e.g. nvfp4, bf16, 4bit",
  "backend": {
    "type": "FILL_ME vllm or mlx",
    "host": "127.0.0.1",
    "port": 8100
  },
  "server": {
    "vllm_project": "serving/vllm",
    "mlx_project": "serving/mlx",
    "startup_timeout_s": 1800
  },
  "models": [],
  "request": {
    "temperature": 0,
    "max_tokens": 256,
    "thinking": "off",
    "cache_busting": "each request's user message starts with a deterministic 8-hex nonce so the server's prompt cache cannot skip prefill",
    "timeout_s": 1800
  },
  "sweep": {
    "concurrency_levels": [1, 2, 4, 8, 16, 32, 64, 128],
    "reps": 5,
    "reps_from_32_users": 3,
    "warmup_max_tokens": 16,
    "warmup_all_slots": true,
    "idle_baseline_s": 10
  },
  "thresholds": {
    "p95_ttft_s_max": 2.0,
    "decode_tps_min": 10.0,
    "decode_stat": "median",
    "decode_stats": ["median", "mean", "p05", "min"],
    "scenarios": [
      {"name": "interactive", "p95_ttft_s_max": 2.0, "decode_tps_min": 10.0},
      {"name": "relaxed", "p95_ttft_s_max": 5.0, "decode_tps_min": 5.0},
      {"name": "strict", "p95_ttft_s_max": 1.0, "decode_tps_min": 20.0}
    ]
  },
  "run": {
    "time_budget_hours": 24
  },
  "prompts": {
    "path": "prompts/prompts_v1.jsonl",
    "sha256": "5c7772860192c2ae65e360358407585aca613810ddfa05687ff67b5b7a8e199d"
  },
  "power": {
    "interval_s": 1,
    "source": "nvidia-smi power.draw on NVIDIA (GPU only; unified memory and CPU are not included, so use the wall meter for system power). Not recorded on Macs in 2.0."
  },
  "quality": {
    "enabled": true,
    "tasks": ["mmlu_pro", "gpqa_diamond_cot_zeroshot", "ifeval", "gsm8k_cot_zeroshot", "humaneval_instruct", "aime25"],
    "limits": {"mmlu_pro": 100},
    "gated_tasks": ["gpqa_diamond_cot_zeroshot"],
    "code_exec_tasks": ["humaneval_instruct"],
    "allow_code_execution": true,
    "num_concurrent": 32,
    "slots": 32,
    "context": 16384,
    "max_gen_toks": 4096,
    "gen_kwargs": "temperature=0"
  }
}
